# Application (client) ID de tu App Registration (frontend SPA)
ENTRA_CLIENT_ID=TU_CLIENT_ID

# Directory (tenant) ID de tu tenant
ENTRA_TENANT_ID=TU_TENANT_ID

# URL base de login de Entra
ENTRA_AUTHORITY=https://login.microsoftonline.com/TU_TENANT_ID/v2.0

# Application ID URI de tu API (api://<client-id>)
ENTRA_API_URI=api://TU_CLIENT_ID

# Scope que expones desde tu API (api://<client-id>/access_as_user)
ENTRA_API_SCOPE=api://TU_CLIENT_ID/access_as_user

# Redirect URI del frontend (local)
FRONTEND_REDIRECT_URI=http://localhost:4200

# Puerto donde corre el backend de usuarios (API privada)
USERS_SERVICE_PORT=8083

# ===== PRODUCCION (GitHub Pages) =====

# URL base de la API en produccion.
#  - Fase actual (directo al EC2): https://TU_EC2_IP.sslip.io  (con Caddy/HTTPS)
#  - Fase API Gateway (siguiente): https://TU_API_ID.execute-api.TU_REGION.amazonaws.com
# El frontend publicado llamara a:  <PROD_BACKEND_URL>/api/products, /api/categories, /api/users, /api/orders
PROD_BACKEND_URL=https://PASTITO.ip.sslip.io

# URL exacta donde quedara publicado el frontend (GitHub Pages).
# Ej: https://USUARIO.github.io/CLOUD-NATIVE-I
PROD_REDIRECT_URI=https://pastito-247.github.io/CLOUD-NATIVE-I

# ============================================================
# RABBITMQ (CloudAMQP / instancia existente)
# Las usan payments-service, orders-service, users-service, products-service
# y rabbitmq-admin-service.
# En local usa el clúster de docker-compose (2 nodos): tuki / tuki.
# En la nube usa los valores de CloudAMQP.
#   Ej CloudAMQP: RABBITMQ_HOST=woodpecker.rmq.cloudamqp.com
#                 RABBITMQ_PORT=5671  RABBITMQ_SSL=true
#                 RABBITMQ_VHOST=<tu-vhost> (suele ser igual al usuario)
# ============================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=tuki
RABBITMQ_PASSWORD=tuki
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# Management HTTP API de RabbitMQ (solo la usa rabbitmq-admin-service para listar).
# CloudAMQP la expone en el mismo host (HTTPS). En local: http://localhost:15672
RABBITMQ_MANAGEMENT_ENABLED=true
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# Puerto del microservicio administrador de RabbitMQ
RABBITMQ_ADMIN_SERVICE_PORT=8085

# ============================================================
# PAYMENTS-SERVICE (flujo de pago simulado)
# ============================================================
# Retardo (ms) de la simulacion de la pasarela de pago (cola de pantalla).
PAYMENT_DELAY_MS=5000

# Directorio donde se guardan las boletas PDF generadas.
RECEIPT_STORAGE_DIR=receipts

# ============================================================
# EMAIL (SMTP Gmail) - correo real de confirmacion + boleta
# Lo usa users-service (ReceiptEmailConsumer -> NotificationService -> EmailService).
# Para enviar el correo REAL al mail del usuario: MAIL_ENABLED=true y completar
# SMTP_USERNAME/SMTP_PASSWORD con una cuenta Gmail y su "contrasena de aplicacion"
# (Google Account > Seguridad > Verificacion en dos pasos > Contrasenas de
# aplicacion). Con MAIL_ENABLED=false el envio real se omite (solo log/registro).
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu-correo@gmail.com
SMTP_PASSWORD=tu-app-password
MAIL_ENABLED=false
MAIL_FROM=tu-correo@gmail.com
MAIL_FROM_NAME=Tuki-Tech

# ============================================================
# LOGIN LOCAL (cuentas creadas en /register)
# ============================================================
# users-service firma un JWT (HS256) para estas cuentas; TODOS los
# microservicios lo validan con el MISMO secreto compartido.
# Cambia el secreto en produccion. Debe tener >= 32 caracteres.
LOCAL_JWT_ISSUER=tuki-tech-local
LOCAL_JWT_SECRET=tuki-tech-local-dev-secret-change-me-0123456789
# Vigencia del token local (minutos); solo lo usa users-service al emitirlo.
LOCAL_JWT_EXPIRATION_MINUTES=60

