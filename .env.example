# Application (client) ID de tu App Registration (frontend SPA)
ENTRA_CLIENT_ID=TU_CLIENT_ID

# Directory (tenant) ID de tu tenant
ENTRA_TENANT_ID=TU_TENANT_ID

# URL base de login de Entra
ENTRA_AUTHORITY=https://login.microsoftonline.com/TU_TENANT_ID/v2.0

# Application ID URI de tu API (api://<client-id>)
ENTRA_API_URI=api://TU_CLIENT_ID

# Scope que expones desde tu API (api://<client-id>/access_as_user)
ENTRA_API_SCOPE=api://TU_CLIENT_ID/access_as_user

# Redirect URI del frontend (local)
FRONTEND_REDIRECT_URI=http://localhost:4200

# Puerto donde corre el backend de usuarios (API privada)
USERS_SERVICE_PORT=8083

# ===== PRODUCCION (GitHub Pages) =====

# URL HTTPS de tu backend en el EC2 (dominio apuntando al EC2, ej: Caddy/Cloudflare).
# El frontend publicado llamara a:  <PROD_BACKEND_URL>/api/products, /api/categories, /api/users, /api/orders
PROD_BACKEND_URL=https://backend.MIDOMINIO.com

# URL exacta donde quedara publicado el frontend (GitHub Pages).
# Ej: https://USUARIO.github.io/CLOUD-NATIVE-I
PROD_REDIRECT_URI=https://USUARIO.github.io/CLOUD-NATIVE-I
